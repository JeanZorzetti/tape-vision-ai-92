# PostgreSQL (Neon) connection string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Random 32+ char secret used to hash visitor IPs for rate limiting (never store raw IPs)
IP_HASH_SALT=

# roihub CRM sync — unset in local dev, sync is skipped (not failed)
ROIHUB_WEBHOOK_URL=
ROIHUB_API_KEY=
ROIHUB_TIMEOUT_MS=3000
