---
// The hero's signature visual: a CSS-only, illustrative tape/book panel. No JS, no
// image, fixed height so it never causes layout shift. Every number here is a fixed,
// invented illustration — never wired to a real feed — so the visible caption below
// makes that explicit (a claim of live data here would be a false representation).
interface TapeRow {
  time: string;
  price: string;
  qty: string;
  side: 'C' | 'V';
}

const tapeRows: TapeRow[] = [
  { time: '14:32:07', price: '5.187,50', qty: '25', side: 'C' },
  { time: '14:32:07', price: '5.187,50', qty: '10', side: 'C' },
  { time: '14:32:08', price: '5.187,00', qty: '80', side: 'V' },
  { time: '14:32:08', price: '5.187,50', qty: '5', side: 'C' },
  { time: '14:32:09', price: '5.188,00', qty: '15', side: 'C' },
  { time: '14:32:09', price: '5.187,00', qty: '120', side: 'V' },
  { time: '14:32:10', price: '5.188,00', qty: '30', side: 'C' },
  { time: '14:32:10', price: '5.188,50', qty: '8', side: 'C' },
];

interface BookRow {
  price: string;
  side: 'C' | 'V';
  pct: number;
  absorption?: boolean;
}

const bookRows: BookRow[] = [
  { price: '5.189,00', side: 'V', pct: 35 },
  { price: '5.188,50', side: 'V', pct: 58 },
  { price: '5.188,00', side: 'V', pct: 42 },
  { price: '5.187,50', side: 'V', pct: 90, absorption: true },
  { price: '5.187,00', side: 'C', pct: 64 },
  { price: '5.186,50', side: 'C', pct: 48 },
  { price: '5.186,00', side: 'C', pct: 30 },
];
---

<div class="tape-panel">
  <div class="tape-panel-inner" aria-hidden="true">
    <div class="ts-col">
      <p class="col-label">Time &amp; sales</p>
      <div class="ts-viewport">
        <ul class="ts-list">
          {
            [...tapeRows, ...tapeRows].map((row) => (
              <li class={row.side === 'C' ? 'buy' : 'sell'}>
                <span class="ts-time">{row.time}</span>
                <span class="ts-price">{row.price}</span>
                <span class="ts-qty">{row.qty}</span>
                <span class="ts-side">{row.side}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="book-col">
      <p class="col-label">Livro de ofertas</p>
      <ul class="book-list">
        {
          bookRows.map((row) => (
            <li class={row.side === 'C' ? 'buy' : 'sell'}>
              <span class="book-price">{row.price}</span>
              <span class="book-bar-track">
                <span class="book-bar" style={`--pct: ${row.pct}%`} />
              </span>
              {row.absorption && <span class="badge-absorcao">Absorção</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="tape-panel-caption">
    Ilustração de leitura de fita — não é cotação em tempo real.
  </p>
</div>

<style>
  .tape-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tape-panel-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    height: 400px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .ts-col,
  .book-col {
    background: var(--surface);
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .col-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ts-viewport {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
  }

  .ts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    animation: tape-scroll 14s linear infinite;
  }

  .ts-list li {
    display: grid;
    grid-template-columns: 4.5rem 1fr 2.25rem 1rem;
    gap: 0.5rem;
    align-items: baseline;
    padding-block: 0.3125rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--surface-2);
  }

  .ts-time {
    color: var(--muted);
  }

  .ts-list li.buy .ts-price,
  .ts-list li.buy .ts-side {
    color: var(--buy);
  }

  .ts-list li.sell .ts-price,
  .ts-list li.sell .ts-side {
    color: var(--sell);
  }

  .ts-qty {
    color: var(--text);
    text-align: right;
  }

  .ts-side {
    text-align: right;
    font-weight: 500;
  }

  @keyframes tape-scroll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    flex: 1;
  }

  .book-list li {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .book-price {
    color: var(--text);
  }

  .book-bar-track {
    display: block;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .book-bar {
    display: block;
    height: 100%;
    width: var(--pct);
    border-radius: 999px;
  }

  .book-list li.buy .book-bar {
    background: var(--buy);
  }

  .book-list li.sell .book-bar {
    background: var(--sell);
  }

  .badge-absorcao {
    justify-self: start;
    white-space: nowrap;
    background: var(--focus);
    color: #1a1300;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.125rem 0.375rem;
    border-radius: 999px;
    animation: absorcao-pulse 1.8s ease-in-out infinite;
  }

  @keyframes absorcao-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  .tape-panel-caption {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-list,
    .badge-absorcao {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .tape-panel-inner {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      height: 640px;
    }
  }
</style>
