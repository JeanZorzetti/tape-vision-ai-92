---
import Logo from './Logo.astro';
import { NAV_LINKS, PRODUCT_NAME } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<nav class="container" aria-label="Principal">
  <a href="/" class="brand" aria-label={PRODUCT_NAME}>
    <Logo height={26} />
  </a>
  <ul>
    {
      NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class={link.href === '/acesso' ? 'nav-cta' : undefined}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.875rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    text-decoration: none;
    color: var(--text);
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--buy);
  }

  .nav-cta {
    padding: 0.5rem 1rem;
    border: 1px solid var(--buy);
    border-radius: 0.5rem;
    color: var(--buy);
  }

  .nav-cta:hover {
    background: rgb(0 255 136 / 0.08);
  }

  @media (max-width: 520px) {
    ul {
      gap: 1rem;
    }
  }
</style>
