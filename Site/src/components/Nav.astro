---
import Logo from './Logo.astro';
import { NAV_LINKS, PRODUCT_NAME } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<nav aria-label="Principal">
  <a href="/" class="brand" aria-label={PRODUCT_NAME}>
    <Logo height={28} />
  </a>
  <ul>
    {
      NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    text-decoration: none;
    color: var(--color-text);
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
