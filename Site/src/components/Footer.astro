---
import Disclaimer from './Disclaimer.astro';
import { NAV_LINKS, ORG } from '../lib/site';

const year = new Date().getFullYear();
---

<footer>
  <nav aria-label="Rodapé">
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li><a href="/privacidade">Privacidade</a></li>
    </ul>
  </nav>
  <Disclaimer />
  <p class="copyright">&copy; {year} {ORG.name}. Todos os direitos reservados.</p>
</footer>

<style>
  footer {
    padding: 2rem 1rem 3rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--color-text-muted);
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
