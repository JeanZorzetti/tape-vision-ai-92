---
import Disclaimer from './Disclaimer.astro';
import Logo from './Logo.astro';
import { NAV_LINKS, ORG, PRODUCT_NAME } from '../lib/site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={PRODUCT_NAME}>
        <Logo height={24} />
      </a>
      <p class="tagline">Leitura de fita e fluxo de ordens para o mini-dólar (WDO) na B3.</p>
    </div>

    <nav aria-label="Rodapé">
      <p class="col-title">Navegação</p>
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Legal">
      <p class="col-title">Legal</p>
      <ul>
        <li><a href="/privacidade">Privacidade</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-legal">
    <Disclaimer />
    <p class="copyright">&copy; {year} {ORG.name}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  footer {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    border-top: 1px solid var(--hairline);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .footer-brand .footer-logo {
    display: inline-flex;
    text-decoration: none;
    color: var(--text);
  }

  .tagline {
    margin-top: 0.75rem;
    max-width: 32ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .col-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }

  .footer-legal {
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
