---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TapePanel from '../components/TapePanel.astro';
import { SITE_ORIGIN, PRODUCT_NAME } from '../lib/site';
import { graph, organizationNode, websiteNode, webPageNode, softwareApplicationNode } from '../lib/schema';

const concepts = (await getCollection('conceitos', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const title = `${PRODUCT_NAME} — leitura de fita para o mini-dólar (WDO) na B3`;
const description =
  'Tape Vision AI analisa fluxo de ordens — time & sales, livro de ofertas, absorção e agressão — ' +
  'para traders de mini-dólar (WDO) na B3. Sem indicadores gráficos. Acesso antecipado disponível.';

const pageURL = new URL('/', SITE_ORIGIN).toString();

const pageGraph = graph([
  organizationNode(),
  websiteNode(),
  webPageNode(pageURL, { name: title, description }),
  softwareApplicationNode({ description }),
]);

const readCards = [
  {
    title: 'Time & sales',
    href: '/como-funciona',
    text: 'A sequência de negócios executados — preço, volume e quem foi o agressor, comprador ou vendedor.',
  },
  {
    title: 'Livro de ofertas',
    href: '/conceitos/livro-de-ofertas',
    text: 'As ofertas de compra e venda ainda não executadas ("order book"), e como elas se movem.',
  },
  {
    title: 'Absorção',
    href: '/conceitos/absorcao',
    text: 'Volume grande negociado num preço sem que ele se mova — sinal de ordem grande segurando a pressão contrária.',
  },
  {
    title: 'Agressão',
    href: '/conceitos/agressao',
    text: 'A intensidade com que compradores ou vendedores "batem" contra o livro para executar a qualquer preço.',
  },
];
---

<Base title={title} description={description} graph={pageGraph}>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">WDO · B3 · Fluxo de ordens</p>
      <h1>Leia a fita, não o gráfico.</h1>
      <p class="lead">
        <strong>Tape Vision AI</strong> lê o <strong>mini-dólar (WDO)</strong>, o contrato futuro de
        dólar negociado na <strong>B3</strong>, pelo <em>fluxo de ordens</em> — time &amp; sales,
        livro de ofertas, absorção e agressão — como um operador de mesa proprietária lê a fita, não
        por indicadores de gráfico ou médias móveis.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/acesso">Entrar na lista de acesso antecipado</a>
        <a class="hero-secondary" href="/como-funciona">Como funciona</a>
      </div>
      <p class="hero-reinforcement">Sem sinal automático. Sem promessa de lucro.</p>
    </div>

    <div class="hero-visual">
      <TapePanel />
    </div>
  </section>

  <section class="reads container">
    <h2>O que o sistema lê</h2>
    <p class="section-lead">
      Quatro sinais de leitura de fita ("tape reading"), lidos em tempo real no fluxo de ordens do
      WDO — não desenhados sobre o gráfico de preço.
    </p>
    <div class="reads-grid">
      {
        readCards.map((card) => (
          <a class="card read-card" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="audience container">
    <div class="audience-col audience-yes">
      <p class="eyebrow">Para quem é</p>
      <p>
        Para traders de <strong>mini-dólar (WDO)</strong> na <strong>B3</strong> que já operam com
        leitura de fita ("tape reading") e querem uma ferramenta que analise esse fluxo de ordens em
        tempo real — não mais um indicador de gráfico repaginado.
      </p>
    </div>
    <div class="audience-col audience-no">
      <p class="eyebrow eyebrow-sell">Para quem não é</p>
      <p class="disqualifier">
        Não é para quem busca sinais automáticos de compra/venda, robôs de "lucro garantido" ou
        ferramentas baseadas em indicadores técnicos de gráfico — se é isso que você procura, este
        não é o produto certo para você.
      </p>
    </div>
  </section>

  {
    concepts.length > 0 && (
      <section class="concepts container">
        <h2>Conceitos de leitura de fita</h2>
        <div class="concepts-grid">
          {concepts.map((c) => (
            <a class="card concept-card" href={`/conceitos/${c.id}`}>
              <h3>{c.data.title}</h3>
              <p>{c.data.answer}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section slot="cta" class="cta container">
    <h2>Pronto para ler a fita?</h2>
    <a class="btn-secondary" href="/acesso">Entrar na lista de acesso antecipado</a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .hero-copy .lead {
    font-size: 1.125rem;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-block: 1.5rem 1rem;
  }

  .hero-secondary {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-reinforcement {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }

  .section-lead {
    color: var(--muted);
    max-width: 60ch;
  }

  .reads,
  .audience,
  .concepts {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-top: 1px solid var(--hairline);
  }

  .reads-grid,
  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .card {
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--buy);
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .concept-card p {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .audience {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .audience-col {
    border-left: 3px solid var(--buy);
    padding-left: 1.25rem;
  }

  .audience-no {
    border-left-color: var(--sell);
  }

  .eyebrow-sell {
    color: var(--sell);
  }

  .disqualifier {
    color: var(--text);
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .audience {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
